# Nabız ayarları. Bu dosyayı .env olarak kopyala; .env GitHub'a GÖNDERİLMEZ. Ayrıntı: docs/SUNUCU_KURULUMU.md

# --- Adres -------------------------------------------------------------------
APP_URL=https://nabiz.ysfdurak.com/
PORT=8080
DATA_DIR=/data

# --- Çalışma biçimi ------------------------------------------------------------
# demo : her ziyaretçi kendi deneme alanında çalışır (72 saatte silinir), gönderimler benzetimdir.
#        SITE_SIFRESI tanımlıysa onunla giren kişi kurum alanını ("ana") kullanır ve gönderimler gerçektir.
# kurum: herkes SITE_SIFRESI ile girer; deneme alanı yoktur. Şirket içi kurulum için.
MOD=demo
SITE_SIFRESI=
OTURUM_SAAT=12

# --- Deneme alanı sınırları ----------------------------------------------------
DEMO_SAAT=72
DEMO_AZAMI_ALAN=300
IP_GUNLUK_ALAN=10
DAKIKALIK_ISTEK=90

# --- Arıza Defteri (ekipman, kişi listeleri; "ekipman çalışamıyor" → arıza kaydı) ---
# Aynı sunucudaysa iç ağ adresi: http://ariza-defteri:8080
ARIZA_DEFTERI_URL=
# Arıza Defteri'nin .env'indeki YAZMA_ANAHTARLARI'ndan biri. Boşsa arıza bildirimi benzetim olur.
ARIZA_YAZMA_ANAHTARI=

# --- Pusula (kırmızı etiket → iş) --------------------------------------------------
# Pusula'nın MCP kapısı. Aynı sunucudaysa: http://pusula:8080/mcp
PUSULA_MCP_URL=
# Pusula .env → MCP_TOKENS="nabiz@ysfdurak.com:<anahtar>" ile tanımlanan hizmet hesabının anahtarı.
PUSULA_ANAHTARI=
# Hizmet hesabının birden çok çalışma alanı varsa kimliği; işin düşeceği ekip adı (isteğe bağlı).
PUSULA_CALISMA_ALANI=
PUSULA_EKIP=

# --- Nabız Analiz (Python: güvenilirlik ve bakım aralığı) -----------------------
# Aynı sunucudaysa iç ağ adresi: http://nabiz-analiz:8000. Boşsa "Analiz" ekranı "tanımlı değil" der.
ANALIZ_URL=

# --- MCP kapısı (Claude) ---------------------------------------------------------------
MCP_ENABLED=false
MCP_ANAHTARLARI=
